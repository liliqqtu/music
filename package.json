{
  "name": "anime-lyric-player-mv",
  "version": "1.0.0",
  "description": "Aesthetic Japanese Anime Vertical & Widescreen Lyric Player MV Generator powered by Remotion",
  "repository": {
    "type": "git",
    "url": "https://github.com/liliqqtu/music.git"
  },
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "remotion studio",
    "start": "remotion studio",
    "build": "remotion bundle",
    "render:vertical": "remotion render VerticalPlayerMV out/vertical-player-mv.mp4",
    "render:widescreen": "remotion render IceCreamMV out/widescreen-mv.mp4",
    "still": "remotion still VerticalPlayerMV out/preview.png --frame=1900",
    "pipeline": "python scripts/render_pipeline.py",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
    "@remotion/cli": "4.0.535",
    "@remotion/media": "4.0.535",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.535",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  }
}
